# --- OpenAI -------------------------------------------------------------------------------------
# Your real OpenAI API key. It never leaves this machine; Cursor only receives RELAY_TOKEN.
OPENAI_API_KEY=sk-proj-...

# Upstream origin. Only change this to test a different endpoint.
OPENAI_UPSTREAM=https://api.openai.com

# --- Relay --------------------------------------------------------------------------------------
# Random secret that you enter in Cursor as "OpenAI API Key". Generate with: openssl rand -hex 32
RELAY_TOKEN=

# Local bind address of the relay.
HOST=127.0.0.1
PORT=8787

# Model alias prefix. Cursor's backend refuses model names from its own registry (e.g. gpt-6-astra)
# when a custom base URL is used, so you configure aliases as Custom Models in Cursor:
#   <prefix><model>[-<effort>]   e.g. relay-gpt-6-astra-high  ->  gpt-6-astra with reasoning.effort=high
# Effort suffixes: none | minimal | low | medium | high | xhigh. Empty = no aliasing.
MODEL_PREFIX=relay-

# Reasoning effort used when neither the alias suffix nor the request specify one. Empty = model default.
REASONING_EFFORT=medium

# --- Tunnel (embedded ngrok) ----------------------------------------------------------------------
# Authtoken from https://dashboard.ngrok.com/get-started/your-authtoken. Leave empty to run the relay
# locally only (e.g. when you bring your own tunnel).
NGROK_AUTHTOKEN=

# Reserved ngrok domain, e.g. the free dev domain every account has (https://dashboard.ngrok.com/domains).
# Empty = random ngrok URL on every start (you would have to update Cursor each time).
NGROK_DOMAIN=

# --- Transport limits (apply with cache enabled, disabled, or bypassed) -----------------------------
RELAY_MAX_REQUEST_BYTES=67108864
RELAY_MAX_RESPONSE_BYTES=67108864
RELAY_MAX_SSE_EVENT_BYTES=8388608
RELAY_IDLE_TIMEOUT_MS=900000
RELAY_DELIVERY_TIMEOUT_MS=30000
# SSE comments during converted-stream silence; does not extend upstream inactivity. 0 disables.
RELAY_SSE_KEEPALIVE_MS=15000

# --- Encrypted reasoning replay (opt-in) ----------------------------------------------------------
# Persistent local cache; plaintext assistant/tool output and encrypted reasoning are sensitive.
REASONING_CACHE_ENABLED=0
REASONING_CACHE_DB_PATH=data/reasoning-cache.sqlite
# Minimum 30 days since last use; restarts conservatively defer deletion by 30 trusted days.
REASONING_CACHE_IDLE_DAYS=30
REASONING_CACHE_MEMORY_MAX_BYTES=134217728
REASONING_CACHE_DISK_MAX_BYTES=1073741824
REASONING_CACHE_RESERVE_BYTES=67108864
REASONING_CACHE_ENTRY_MAX_BYTES=4194304
# Actual serialized output bytes across the selected replay chain (no hidden multiplier/divisor).
REASONING_CACHE_REPLAY_MAX_BYTES=16777216
REASONING_CACHE_PLAN_MAX_RECORDS=256
# Full-cache concurrency, not relay concurrency. Busy cache requests safely bypass caching.
# Defaults admit ten small requests; larger histories may reduce full-cache concurrency.
REASONING_CACHE_MAX_CONCURRENT=10
# Inactivity, not total duration. Allows long initial silent reasoning.
REASONING_CACHE_IDLE_TIMEOUT_MS=900000
REASONING_CACHE_DELIVERY_TIMEOUT_MS=30000

# --- Private local administration ---------------------------------------------------------------
# Opt-in Unix socket, never exposed through ngrok. Blank disables it.
# Suggested: data/admin/relay-admin.sock (private directory, socket permissions 0600).
RELAY_ADMIN_SOCKET=
# Optional; defaults to ~/.openai-relay-inspection. Must have private, non-symlink ancestors.
# Kept outside the checkout so group-writable development directories need not be changed.
RELAY_ADMIN_SNAPSHOT_DIR=

# --- Diagnostics --------------------------------------------------------------------------------
# 1 = write four files per request to LOG_DIR (contains your prompts and the model's answers!):
#   1-client-request, 2-upstream-request, 3-upstream-response, 4-client-response
LOG_BODIES=0
LOG_DIR=logs
